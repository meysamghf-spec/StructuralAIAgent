# ---- copy to .env.production on the server and fill in. NEVER commit the real file. ----
# Domain pointing (A record) to this server, e.g. app.sazeh-ai.ir ; Caddy gets the HTTPS certificate automatically.
DOMAIN=app.example.ir
ACME_EMAIL=you@example.com

# Image / package mirrors (Docker Hub, PyPI and npm can be blocked or slow from Iran). Leave empty to use defaults.
# REGISTRY=docker.arvancloud.ir/
REGISTRY=
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# Database (container "db"). Generate: openssl rand -hex 24
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=structuralaiaagent

# Backend security (validated at startup in production)
APP_ENV=production
AUTH_REQUIRED=true
PROJECT_ACCESS_ENFORCED=true
AUTH_ALLOW_LEGACY_ACTOR=false
# Generate: openssl rand -hex 48
AUTH_JWT_SECRET=change-me-very-long-random
CORS_ORIGINS=https://app.example.ir
TRUSTED_PROXY_HOSTS=172.16.0.0/12
FILE_STORAGE_ROOT=/data/files
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Free-launch mode for Iran: crypto payments (BTCPay) and CoinGecko are not used -> paid-feature gating off.
PAYMENTS_ENABLED=false
ENTITLEMENT_ENFORCEMENT_ENABLED=false
CRYPTO_PAYMENT_GATEWAY=mock
# USDT on BNB Smart Chain (BEP20), watch-only. See docs/billing-crypto-go-live.md.
# CRYPTO_BSC_ADDRESS=0xYourChecksummedAddress
# CRYPTO_LIVE_ASSETS=usdt-bep20
# CRYPTO_BSC_RPC_URLS=https://your-private-rpc,https://bsc-rpc.publicnode.com
# CRYPTO_CONFIRMATIONS=30
# CRYPTO_OVERPAY_TOLERANCE_USDT=1
# BILLING_ADMIN_ACCOUNTS=you@example.com
EXCHANGE_RATE_PROVIDER=stub

# AI: the 3D-frame analysis/design engine is deterministic and needs no LLM.
AI_PROVIDER=stub
AI_ALLOW_DETERMINISTIC_IN_PRODUCTION=true
# Optional OpenAI-compatible gateway reachable from Iran (e.g. Liara AI), then set AI_PROVIDER=openai_compatible:
# OPENAI_API_BASE=https://ai.liara.ir/api/v1/<your-id>
# OPENAI_API_KEY=
# OPENAI_MODEL=
