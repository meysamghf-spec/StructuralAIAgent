# One domain: API + health on the backend, everything else on the Next.js frontend.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 100MB
	}
	@api path /api/* /health /ready /docs /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
