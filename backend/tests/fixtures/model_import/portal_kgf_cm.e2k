$ File portal.e2k (hand-written test sample, ETABS 2016 style)
$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "16.2.1"
$ CONTROLS
  UNITS  "KGF"  "CM"  "C"
$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story2"  HEIGHT 300 MASTERSTORY "Yes"
  STORY "Story1"  HEIGHT 350
  STORY "Base"  ELEV 0
$ DIAPHRAGM NAMES
  DIAPHRAGM "D1"    TYPE RIGID
$ MATERIAL PROPERTIES
  MATERIAL  "C25"    TYPE "Concrete"    WEIGHTPERVOLUME 0.0025
  MATERIAL  "C25"    SYMTYPE "Isotropic"  E 250000  U 0.2
  MATERIAL  "ST37"   TYPE "Steel"    WEIGHTPERVOLUME 0.00785
  MATERIAL  "ST37"   SYMTYPE "Isotropic"  E 2040000  U 0.3
$ FRAME SECTIONS
  FRAMESECTION  "C40"  MATERIAL "C25"  SHAPE "Concrete Rectangular"  D 40 B 40
  FRAMESECTION  "B35X50"  MATERIAL "C25"  SHAPE "Concrete Rectangular"  D 50 B 35
  FRAMESECTION  "IPE300"  MATERIAL "ST37"  SHAPE "IPE300"
  FRAMESECTION  "BR"  MATERIAL "ST37"  SHAPE "Steel Pipe"  D 10 T 0.5
$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  500 0
$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "B1"  BEAM  "1"  "2"  0
  LINE  "D1"  BRACE  "1"  "2"  1
$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ"
$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Story1"  SECTION "C40"
  LINEASSIGN  "C2"  "Story1"  SECTION "C40"
  LINEASSIGN  "C1"  "Story2"  SECTION "C40"
  LINEASSIGN  "C2"  "Story2"  SECTION "C40"
  LINEASSIGN  "B1"  "Story1"  SECTION "B35X50"  RELEASE "M2I M3I"
  LINEASSIGN  "B1"  "Story2"  SECTION "IPE300"
  LINEASSIGN  "D1"  "Story1"  SECTION "BR"
$ AREA CONNECTIVITIES
  AREA "F1"  FLOOR  4  "1"  "2"  "2"  "1"  0 0 0 0
$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN "EQX"  TYPE  "Seismic"  SELFWEIGHT  0
$ POINT OBJECT LOADS
  POINTLOAD  "1"  "Story2"  TYPE "FORCE"  LC "EQX"  FX 1000
$ FRAME OBJECT LOADS
  LINELOAD  "B1"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "Dead"  FVAL 20
  LINELOAD  "B1"  "Story1"  TYPE "TRAPF"  DIR "GRAV"  LC "Live"  FSTART 5 FEND 15 RDSTART 0 RDEND 1
$ SHELL OBJECT LOADS
  AREALOAD  "F1"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "Dead"  FVAL 0.05
$ LOAD COMBINATIONS
  COMBO "ULS1"  TYPE "Linear Add"
  COMBO "ULS1"  LOAD "Dead"  SF 1.2
  COMBO "ULS1"  LOAD "Live"  SF 1.6
  COMBO "ENV"  TYPE "Envelope"
  COMBO "ENV"  LOAD "ULS1"  SF 1
  COMBO "ENV"  LOAD "Modal"  SF 1
$ END OF MODEL FILE
