# Application
APP_ENV=development
API_PORT=8000

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent
POSTGRES_PASSWORD=your_local_postgres_password_here
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent_test

# File storage — outside the repository
FILE_STORAGE_ROOT=/absolute/path/outside/repo/file_storage
MAX_UPLOAD_BYTES=10485760
AUTO_INDEX_FILES=false

# AI Gateway
AI_PROVIDER=stub
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=30
# AI_MAX_RETRIES=2
# ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Payment environment boundaries ---
# DEVELOPMENT/TEST: CRYPTO_PAYMENT_GATEWAY=mock
# PRODUCTION: CRYPTO_PAYMENT_GATEWAY=btcpay (mock blocked unless CRYPTO_PAYMENT_ALLOW_MOCK_IN_PRODUCTION=true)
CRYPTO_PAYMENT_GATEWAY=mock
EXCHANGE_RATE_PROVIDER=stub
# CRYPTO_PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_secret_here
# CRYPTO_PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false

# BTCPay Server (production real provider — non-custodial, API key only)
# BTCPAY_SERVER_URL=https://your-btcpay.example.com
# BTCPAY_API_KEY=your_btcpay_greenfield_api_key_here
# BTCPAY_STORE_ID=your_btcpay_store_id_here
# BTCPAY_WEBHOOK_SECRET=your_btcpay_webhook_secret_here

# Authentication
AUTH_REQUIRED=false
AUTH_ALLOW_LEGACY_ACTOR=true
PROJECT_ACCESS_ENFORCED=false
ENTITLEMENT_ENFORCEMENT_ENABLED=false
# Production requires AUTH_REQUIRED=true, PROJECT_ACCESS_ENFORCED=true,
# AUTH_ALLOW_LEGACY_ACTOR=false, ENTITLEMENT_ENFORCEMENT_ENABLED=true,
# AUTH_JWT_SECRET, CRYPTO_PAYMENT_GATEWAY=btcpay, and BTCPay credentials.
# AUTH_JWT_SECRET=generate_a_long_random_secret_for_production
# Login: "remember me" session length (hours) and brute-force lockout.
# AUTH_REMEMBER_EXPIRY_HOURS=720
# AUTH_MAX_LOGIN_FAILURES=5
# AUTH_LOCKOUT_SECONDS=900
# Sign in with Google (off unless GOOGLE_OAUTH_ENABLED=true and id+secret are set). See docs/GOOGLE_SIGNIN.md.
# GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://structuralai.ir/api/auth/google/callback
# GOOGLE_POST_LOGIN_URL=
# GOOGLE_OAUTH_PROXY=            # optional outbound proxy for backend->Google only

# Deployment / ops
# CORS_ORIGINS=http://localhost:3000
# LOG_LEVEL=INFO
# RUN_MIGRATIONS_ON_STARTUP=false
# TRUST_PROXY_HEADERS=false

# Frontend (build-time)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Platform helper (free ChatGPT-like assistant in the chat box) ---
# Works with NO key (anonymous Pollinations fallback). For quality/reliability add a free key:
#   LLM_GEMINI_API_KEY=...   (aistudio.google.com)   or   LLM_GROQ_API_KEY=...   (console.groq.com)
#   LLM_OPENROUTER_API_KEY=...
# LLM_PROVIDER=auto            # auto | stub | none | <preset> | custom
# LLM_BASE_URL= / LLM_API_KEY= / LLM_MODEL=   # any OpenAI-compatible endpoint (LLM_PROVIDER=custom)
# LLM_FALLBACKS=groq,openrouter,pollinations
# LLM_KEYLESS_FALLBACK=1       # 0 disables the anonymous Pollinations fallback
# PLATFORM_ADMIN_ACCOUNTS=you@example.com       # who may open /workspace/admin/platform-issues
# PLATFORM_ISSUE_ADMIN_TOKEN=                    # machine token for Grok Bot (Bearer)
# PLATFORM_ISSUE_WEBHOOK_URL=                    # optional, off by default
# PLATFORM_ISSUE_WEBHOOK_SECRET=
# PLATFORM_ISSUE_WEBHOOK_AUTH_TOKEN=            # optional: sent as "Authorization: Bearer <token>" (Grok Bot routine webhook)

# TEMPORARY test plan: hidden 1 USDT plan visible/purchasable only by these account ids (comma list). Empty = off.
CRYPTO_TEST_PLAN_USER_IDS=
# CRYPTO_TEST_PLAN_USDT=1
# CRYPTO_TEST_PLAN_DAYS=1
