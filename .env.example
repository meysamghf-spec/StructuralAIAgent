# Application
APP_ENV=development
API_PORT=8000

# Database (PostgreSQL 18.x local)
# Use the existing local database — do NOT commit real credentials.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent

# Supply the postgres user password via environment variable (recommended).
# Copy this file to `.env` and set POSTGRES_PASSWORD locally.
POSTGRES_PASSWORD=your_local_postgres_password_here

# Optional dedicated test database (falls back to resolved DATABASE_URL)
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent

# File ingestion (M5) — local filesystem storage outside the repository
FILE_STORAGE_ROOT=/absolute/path/outside/repo/file_storage
MAX_UPLOAD_BYTES=10485760

# Document indexing (Phase 3) — auto-create project memory after successful file extraction
AUTO_INDEX_FILES=false

# AI Gateway — provider selection (stub default; supply real provider keys in .env when enabling)
AI_PROVIDER=stub
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Crypto payments — mock gateway for CI/local development only
CRYPTO_PAYMENT_GATEWAY=mock
# CRYPTO_PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
# CRYPTO_PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
