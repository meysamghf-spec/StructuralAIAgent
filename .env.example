# Application
APP_ENV=development
API_PORT=8000

# Database (PostgreSQL 18.x local)
# Use the existing local database — do NOT commit real credentials.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent

# Supply the postgres user password via environment variable (recommended).
# Copy this file to `.env` and set POSTGRES_PASSWORD locally.
POSTGRES_PASSWORD=your_local_postgres_password_here

# Optional dedicated test database (falls back to resolved DATABASE_URL)
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/structuralaiaagent
